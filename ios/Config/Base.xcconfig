// What the app and its two extensions share. Each target's own file includes it.

DEVELOPMENT_TEAM = XB89283VYM
CODE_SIGN_STYLE = Automatic
IPHONEOS_DEPLOYMENT_TARGET = 17.2
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
// An extension's versions must be the app's.
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// Simulator builds are signed to run locally: no provisioning profile, nothing registered with the developer account.
// The entitlements go into the binary (the simulator reads them from there).
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

// Info.plists are written out in full (Config/, outside the synchronized source folders).
GENERATE_INFOPLIST_FILE = NO

// iPhone only: no Mac or Vision Pro variants.
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
