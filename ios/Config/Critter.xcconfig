// The Critter app target. Both configurations (Debug, Release) are based on this file.

#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.braynlabs.critter
PRODUCT_NAME = Critter
INFOPLIST_FILE = Config/Info.plist
// Push (development: sandbox tokens, which `PushSetup` registers), time-sensitive notifications, the App Group and the
// keychain group the extensions share.
CODE_SIGN_ENTITLEMENTS = Config/Critter.entitlements

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
// The extensions are embedded signed, as built: copying them does not strip them (each strips itself when installed).
COPY_PHASE_STRIP = NO
ENABLE_PREVIEWS = YES

// Critter/Assets.xcassets: the app icon (light, dark and tinted, from scripts/dev/make-ios-icon.py) and the launch
// screen's sky and icon.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// The DEBUG launch arguments and their fixtures (Critter/Debug/) are not in a release build. A pattern's * does
// not cross a /: each folder is listed. The Live Activity's views (CritterWidgets/, compiled into the app only for
// `-critterActivityDemo`'s page) are left out as well.
EXCLUDED_SOURCE_FILE_NAMES[config=Release] = $(inherited) $(SRCROOT)/Critter/Debug/* $(SRCROOT)/Critter/Debug/Fixtures/* $(SRCROOT)/CritterWidgets/ActivityPictures.swift $(SRCROOT)/CritterWidgets/CritterActivityViews.swift
