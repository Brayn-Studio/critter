<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. A debug build carries the release key and replaces the release app in place, keeping its
    live pairing, so these entry points must not be open to every app on the phone: each one asks for
    android.permission.DUMP, which the adb shell holds (so `adb shell am broadcast` and `am start` keep working)
    and no third-party app can. The app's own calls are not checked against it (same uid).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".DebugPairReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />

        <receiver
            android:name=".DebugSnapshotReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />

        <!-- `am start` needs these reachable from the shell. -->
        <activity
            android:name=".ui.board.BoardActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:replace="android:exported"
            tools:ignore="ExportedActivity" />
        <activity
            android:name=".ui.detail.DetailActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:replace="android:exported"
            tools:ignore="ExportedActivity" />

        <activity
            android:name=".SkinGalleryActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedActivity" />
    </application>
</manifest>
