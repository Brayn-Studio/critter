{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [
        { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 },
        { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" ask", "timeout": 600 }
      ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" event", "timeout": 5 } ] }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^pet$",
        "hooks": [ { "type": "command", "command": "[ -x \"$HOME/.critter/bin/critter-hook\" ] || exit 0; exec \"$HOME/.critter/bin/critter-hook\" pet", "timeout": 10 } ]
      }
    ]
  }
}
